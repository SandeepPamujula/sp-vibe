# Invoice Cursor - Environment Variables
# Copy this file to .env.local for local development
# Never commit .env.local or .env files to version control

# ============================================
# Application Configuration
# ============================================
# Application environment: development, test, staging, production
NODE_ENV=development

# Application name
APP_NAME=invoice-cursor

# Logging level: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# AWS Configuration
# ============================================
# AWS region for all services
AWS_REGION=us-east-1

# AWS Account ID (optional, used for resource ARNs)
# AWS_ACCOUNT_ID=123456789012

# ============================================
# DynamoDB Configuration
# ============================================
# DynamoDB table names
DYNAMODB_USERS_TABLE=invoice-users
DYNAMODB_INVOICES_TABLE=invoice-invoices

# ============================================
# S3 Configuration
# ============================================
# S3 bucket name for invoice file attachments
S3_BUCKET_NAME=invoice-attachments

# S3 bucket region (optional, defaults to AWS_REGION)
# S3_BUCKET_REGION=us-east-1

# ============================================
# Amazon SES Configuration
# ============================================
# SES region (optional, defaults to AWS_REGION)
# SES_REGION=us-east-1

# Email address to send emails from (must be verified in SES)
# SES_FROM_EMAIL=noreply@example.com

# Reply-to email address (optional)
# SES_REPLY_TO_EMAIL=support@example.com

# ============================================
# Sentry Configuration
# ============================================
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry environment (optional, defaults to NODE_ENV)
# SENTRY_ENVIRONMENT=development

# Sentry traces sample rate (0.0 to 1.0, optional)
# SENTRY_TRACES_SAMPLE_RATE=1.0

# ============================================
# API Configuration
# ============================================
# Base URL for API calls (optional)
# API_BASE_URL=http://localhost:3000

# API request timeout in milliseconds (optional, default: 30000)
# API_TIMEOUT_MS=30000

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins (optional)
# CORS_ORIGIN=http://localhost:3000,https://example.com

# Allow credentials in CORS requests (true/false, default: false)
# CORS_CREDENTIALS=false

# ============================================
# Rate Limiting Configuration
# ============================================
# Maximum number of requests per window (optional, default: 100)
# RATE_LIMIT_MAX_REQUESTS=100

# Rate limit window in milliseconds (optional, default: 900000 = 15 minutes)
# RATE_LIMIT_WINDOW_MS=900000

# ============================================
# Next.js Public Configuration
# ============================================
# Public application URL (used for email links, etc.)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Notes
# ============================================
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - In production, use AWS Secrets Manager or Parameter Store for sensitive values
# - AWS credentials are handled via IAM roles in Lambda, not environment variables
# - For local development, configure AWS credentials via ~/.aws/credentials or AWS CLI
