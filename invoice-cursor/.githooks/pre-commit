#!/bin/bash
#
# Pre-commit hook to check if prompt history was updated when code changes
#
# This hook warns if code files were modified but prompt history files were not updated.
# It does NOT block the commit, but provides a warning reminder.

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Filter to only invoice-cursor directory files
INVOICE_CURSOR_FILES=$(echo "$STAGED_FILES" | grep "^invoice-cursor/" || true)

# If no invoice-cursor files were changed, skip this check
if [ -z "$INVOICE_CURSOR_FILES" ]; then
  exit 0
fi

# Check if any code files were changed (excluding prompt history files)
CODE_FILES_CHANGED=false
PROMPT_HISTORY_CHANGED=false

# Patterns for code files (excluding prompt history)
CODE_PATTERNS=(
  "src/"
  "*.ts"
  "*.tsx"
  "*.js"
  "*.jsx"
  "*.json"
  "*.md"
  ".cursorrules"
  ".cursor/"
  "package.json"
  "package-lock.json"
  "tsconfig.json"
  "jest.config.js"
  "next.config.js"
  "eslint.config.mjs"
  ".prettierrc.json"
  ".gitignore"
  ".github/"
)

# Prompt history files
PROMPT_HISTORY_FILES=(
  "prompts-history.md"
  "prompts-history-milestone-*.md"
)

# Check for code file changes
for file in $INVOICE_CURSOR_FILES; do
  # Remove invoice-cursor/ prefix for pattern matching
  file_path="${file#invoice-cursor/}"
  
  # Skip prompt history files in code check
  if [[ "$file_path" == "prompts-history.md" ]] || [[ "$file_path" =~ prompts-history-milestone-.*\.md ]]; then
    continue
  fi
  
  # Check if file matches code patterns
  for pattern in "${CODE_PATTERNS[@]}"; do
    if [[ "$file_path" == *"$pattern"* ]] || [[ "$file_path" == "$pattern" ]]; then
      CODE_FILES_CHANGED=true
      break
    fi
  done
  
  if [ "$CODE_FILES_CHANGED" = true ]; then
    break
  fi
done

# Check if prompt history files were changed
for file in $INVOICE_CURSOR_FILES; do
  # Remove invoice-cursor/ prefix for pattern matching
  file_path="${file#invoice-cursor/}"
  
  if [[ "$file_path" == "prompts-history.md" ]] || [[ "$file_path" =~ prompts-history-milestone-.*\.md ]]; then
    PROMPT_HISTORY_CHANGED=true
    break
  fi
done

# If code changed but prompt history didn't, show warning
if [ "$CODE_FILES_CHANGED" = true ] && [ "$PROMPT_HISTORY_CHANGED" = false ]; then
  echo ""
  echo -e "${YELLOW}⚠️  WARNING: Code files were modified but prompt history was not updated!${NC}"
  echo ""
  echo -e "${YELLOW}According to project rules, you should update the prompt history after each prompt execution.${NC}"
  echo ""
  echo -e "Please update the appropriate milestone file in ${GREEN}invoice-cursor/${NC}:"
  echo -e "  ${GREEN}• invoice-cursor/prompts-history-milestone-{N}.md${NC} (for milestone-specific prompts)"
  echo -e "  ${GREEN}• invoice-cursor/prompts-history.md${NC} (index file, if starting a new milestone)"
  echo ""
  echo -e "See ${GREEN}invoice-cursor/.cursor/docs/prompt-history.md${NC} for format requirements."
  echo ""
  echo -e "${YELLOW}This is a warning only. The commit will proceed.${NC}"
  echo ""
  echo -e "To skip this check in the future, use: ${GREEN}git commit --no-verify${NC}"
  echo ""
  
  # Ask user if they want to continue (non-blocking)
  read -p "Continue with commit? (y/n) " -n 1 -r
  echo ""
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${RED}Commit aborted.${NC}"
    exit 1
  fi
fi

exit 0

