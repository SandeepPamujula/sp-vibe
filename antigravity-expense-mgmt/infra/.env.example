# AWS Configuration
# Set your AWS account ID and region for CDK deployment

# AWS Account ID (12-digit number)
# Get this from: aws sts get-caller-identity --query Account --output text
AWS_ACCOUNT_ID=123456789012

# AWS Region
# Common values: us-east-1, us-west-2, eu-west-1, ap-southeast-1
AWS_REGION=us-east-1

# CDK Default Account (alternative to AWS_ACCOUNT_ID)
# CDK_DEFAULT_ACCOUNT=123456789012

# CDK Default Region (alternative to AWS_REGION)
# CDK_DEFAULT_REGION=us-east-1

# Environment
# Values: dev, staging, production
ENVIRONMENT=dev

# Stack Name Prefix (optional)
# STACK_PREFIX=ExpenseManagement
